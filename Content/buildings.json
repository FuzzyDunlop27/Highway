{
  "_notes": "Phase 1 buildings and defenses. id = graphics-spec name without prefix; sprite = exact asset id (defenses with turrets list base + turret). footprint = [w, h] in tiles. levels[n]: cost = {scrap, food} to build (L1) or upgrade to that level (L2/L3); buildSeconds = in-game seconds at 1x; hp = max HP at that level; requiredHq = min HQ level; effects vary by type: productionPerMin (at full staff, scales linearly with workers staffed), storageAdded (added to food+scrap caps), housing (survivor cap), range (tiles), damage (per shot), fireRate (shots/sec), slowPct (move-speed reduction while on tile), dps (spike damage per second to each zombie on tile). workers = survivors assigned to run it (towers fire only when staffed; a garrisoned defender counts as the worker and applies units.json garrison.towerDamageMultiplier). maxCountByHq = how many may exist at HQ 1/2/3. requires = other prerequisites (building id + level, or research id). startingLayout = what a fresh map places (positions come from the map file). rules = global construction/repair/rubble formulas.",
  "schemaVersion": 1,
  "rules": {
    "constructionSlotsByHq": [2, 3, 4],
    "buildersPerJob": 1,
    "_buildersNote": "each active construction/upgrade/repair borrows this many idle survivors until done",
    "constructionQueueLength": 6,
    "_queueNote": "cost is paid when a job STARTS, not when queued; a queued job auto-starts when a slot, a free builder and the resources are available (also during offline catch-up)",
    "buildDuringHorde": true,
    "demolishRefundPct": 50,
    "cancelRefundPct": 75,
    "_cancelNote": "cancelling a RUNNING construction/upgrade/rebuild refunds this % of its cost; cancelling a queued one costs nothing (it paid nothing)",
    "repair": {
      "costPctOfLevelCost": 50,
      "timePctOfBuildTime": 25,
      "minSeconds": 2,
      "_formula": "repairCost = levelCost * costPct * missingHpFraction; repairTime = max(minSeconds, buildSeconds * timePct * missingHpFraction)"
    },
    "rubble": {
      "rebuildCostPctOfInvested": 50,
      "rebuildTimePctOfInvested": 50,
      "keepsLevel": true,
      "rubbleSprite2x2": "bld_rubble_2x2",
      "rubbleSprite1x1": "dec_rubble"
    },
    "constructionSprites": {
      "2x2": "bld_construction_2x2",
      "3x3": "bld_construction_3x3",
      "1x1": "bld_construction_2x2",
      "_1x1Note": "no 1x1 scaffold sprite in the graphics spec; walls/towers reuse the 2x2 one scaled down"
    }
  },
