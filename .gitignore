# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
# SwiftPM build output
.build/
.swiftpm/
# Blender autosave backups
*.blend1
# Python caches
__pycache__/
# Zips duplicate folders that are already committed (asset pack, Blender study)
*.zip
# Claude Code worktrees and local settings
.claude/

# Mixamo editable source assets stay local; ship rendered PNGs only.
HighwayHoldout_Iso_Art/walker-mixamo/source/*.fbx
HighwayHoldout_Iso_Art/walker-mixamo/local-review/

# Chunk 1R spike: the rigged Mixamo walker as USDZ stays local too (regenerate with tools/blender/spike_export_usdz.py).
App/Spike3D/Models/zmb_walker_mixamo.usdz

# Free-asset spike: downloaded CC0 sources and their USDZ stay local (regenerate with tools/blender/free_assets_spike_export.py).
HighwayHoldout_3D_Sources/free-assets/
App/Spike3D/FreeAssets/

# Mixamo FBX kept in the 3D sources folder stay local too (same rule as above).
HighwayHoldout_3D_Sources/mixamo-walker/*.fbx

# Chunk 3M: animated characters are Mixamo-derived, so they stay local like their FBX (D-038, public repo).
# Rebuild with tools/blender/export_characters.py; a fresh clone shows labeled boxes for zombies and defenders.
App/Models/zmb_*.usdz
App/Models/unit_*.usdz
App/Models/sv_*.usdz
App/Models/*.anim.json
HighwayHoldout_3D_Sources/mixamo-*/*.fbx

# Chunk 1X owner downloads: Mixamo humans (any depth) and downloaded terrain textures stay local (public repo).
HighwayHoldout_3D_Sources/mixamo-*/**/*.fbx
HighwayHoldout_3D_Sources/terrain/

# Owner-provided Mixamo farmer motion downloads stay local (D-038).
HighwayHoldout_3D_Sources/makehuman/sv-farmer_*.fbx
